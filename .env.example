# DB config
DATABASE_HOST=tinvest-analytics-mysql
DATABASE_PORT=3306
DATABASE_NAME=tinvest_analytics
DATABASE_USERNAME=admin
DATABASE_PASSWORD=111111

# Memcached
MEMCACHED_HOST=tinvest-analytics-memcached
MEMCACHED_PORT=11211
MEMCACHED_WEIGHT=16

# RabbitMQ
RABBITMQ_HOST=tinvest-analytics-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit
RABBITMQ_PASSWORD=111111
RABBITMQ_VHOST=/

# Auth
# Generate keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   JWT_PRIVATE_KEY=$(base64 -w0 private.pem)    # Linux
#   JWT_PRIVATE_KEY=$(base64 private.pem)        # macOS
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISS=tinvest-analytics
JWT_AUD=tinvest-analytics

ACCESS_TTL=900
REFRESH_TTL=2592000
COOKIE_PATH=/api

# WebSocket
WS_PORT=8081

# Broker token encryption (base64-encoded 32-byte AES-256 key)
# Generate: php -r "echo base64_encode(random_bytes(32));"
BROKER_TOKEN_ENCRYPTION_KEY=79PcJmVUDP/vumMvDOGjUTnnlkmQ9QnatU14gAMBDEQ=
